{
  "name": "onlytag",
  "version": "0.1.0",
  "description": "onlytag is a tag-based notation with three kinds of tags, JSON attributes, and decorations.",
  "keywords": [
    "json",
    "lexer",
    "notation",
    "parser",
    "tags",
    "tokenizer"
  ],
  "homepage": "https://github.com/x0y14/onlytag#readme",
  "bugs": {
    "url": "https://github.com/x0y14/onlytag/issues"
  },
  "license": "MIT",
  "author": "Yuhei Yamauchi",
  "repository": {
    "type": "git",
    "url": "https://github.com/x0y14/onlytag.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:fuzz": "vitest run tests/*.prop.ts",
    "test:coverage": "vitest run --coverage",
    "test:perf": "vitest run tests/performance.test.ts",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run clean && pnpm run build && pnpm run lint && pnpm run typecheck && pnpm run test && npm --cache .npm-cache pack --dry-run"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.12",
    "fast-check": "^4.5.3",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.30.2"
}
